{
  "name": "universe-view",
  "version": "4.6.1",
  "description": "Timelines, family trees, organisation charts, relationship graphs and maps for your worlds, built from your notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "harness": "node esbuild.config.mjs production && node dev/build-harness.mjs --serve",
    "install-example": "node scripts/install-example.mjs",
    "test": "node dev/build-tests.mjs && node dev/out/tests.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "timeline",
    "genealogy",
    "worldbuilding",
    "map"
  ],
  "author": "Oli_G",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/d3-force": "^3.0.9",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "lucide": "^1.73.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.4.5"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "leaflet": "^1.9.4",
    "polygon-clipping": "0.15.7"
  }
}
